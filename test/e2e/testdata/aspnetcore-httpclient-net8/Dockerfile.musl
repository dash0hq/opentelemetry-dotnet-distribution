# SPDX-License-Identifier: Apache-2.0
#
# Builds examples/aspnetcore-httpclient-net8 with the real OTel injector and
# the tracer-home under test wired in via LD_PRELOAD, for E2E testing.
#
# The net8.0 twin of the aspnetcore-httpclient scenario, validating that
# instrumentation-image packaging changes don't regress ASP.NET Core tracing
# above the net6.0/net7.0 floor.
#
# musl-only Alpine counterpart of ./Dockerfile -- see that file's header
# (and grpc-client/Dockerfile's, the original rationale) for why this
# scenario keeps the two flavors as fully separate files instead of the ARG
# LIBC_FLAVOR-branched pattern. Selected by harness.stageBuildContext
# whenever DASH0_E2E_LIBC_FLAVOR is "musl" and this file is present
# alongside the scenario's Dockerfile.
#
# Build context is staged by test/e2e/harness (see container.go): it is not
# the repo itself, but a temp dir containing:
#   app/          - a copy of examples/aspnetcore-httpclient-net8
#   tracer-home/  - the tracer-home under test (harness.TracerHome), staged
#                   under tracer-home/musl/ for this file

FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src
COPY app/AspNetCoreHttpClientNet8.csproj .
RUN dotnet restore
COPY app/. .
RUN dotnet publish -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine
WORKDIR /app
COPY --from=build /app .

# The Dash0 .NET distribution under test, laid out exactly as the release
# tarballs extract (net/, linux-musl-x64/, instrument.sh, ...) -- already
# nested under musl/ by the harness.
COPY tracer-home/ /dash0-instrumentation/dotnet/

# The real OTel injector, same download source dash0-operator's
# instrumentation image uses. Checksum verification is skipped here (unlike
# that image) since this is test-only infrastructure, not a shipped
# artifact. The injector binary itself isn't libc-flavor-specific (see
# RELEASE.md / opentelemetry-injector's own release assets: one .so per
# arch, no glibc vs musl split), only how it's fetched here (apk vs apt)
# differs from ./Dockerfile.
ARG INJECTOR_VERSION=v0.11.0
ARG INJECTOR_ARCH=amd64
RUN apk add --no-cache curl ca-certificates \
    && curl -fsSL -o /usr/lib/libotelinject.so \
      "https://github.com/open-telemetry/opentelemetry-injector/releases/download/${INJECTOR_VERSION}/libotelinject_${INJECTOR_ARCH}.so"

COPY injector.conf /etc/opentelemetry/injector.conf
ENV LD_PRELOAD=/usr/lib/libotelinject.so
ENV OTEL_INJECTOR_CONFIG_FILE=/etc/opentelemetry/injector.conf
ENV OTEL_INJECTOR_LOG_LEVEL=debug
ENV OTEL_SERVICE_NAME=aspnetcore-httpclient-net8-e2e
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "AspNetCoreHttpClientNet8.dll"]
