<Project>
  <Import Project="..\Directory.Build.props" />

  <PropertyGroup>
    <!-- R21 runtime set for all Dash0-authored src projects. net10.0 is
         added when SDK 10 is available in the local/CI environment. -->
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0</TargetFrameworks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
