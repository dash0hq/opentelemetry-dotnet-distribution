<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
  </ItemGroup>

  <!--
    Checked-in output of Grpc.Tools' protoc/grpc_csharp_plugin codegen for
    Protos/greet.proto (via <Protobuf Include="Protos/greet.proto"
    GrpcServices="Both" />), rather than generating it at build time.
    Grpc.Tools 2.66.0's bundled arm64 protoc binary fails to even start
    ("No such file or directory" from execve) on GitHub's arm64-hosted
    runners specifically; it reproduces neither on real arm64 hardware
    outside CI nor under QEMU-emulated arm64, so it's a runner-specific
    quirk, not something fixable here. Regenerate by temporarily restoring
    the Grpc.Tools PackageReference and the <Protobuf> item below, running
    `dotnet build -f net8.0`, and copying
    obj/Release/net8.0/Protos/{Greet,GreetGrpc}.cs over these two files.
    No explicit Compile item is needed: the SDK already globs **/*.cs by
    default, which picks up Generated/*.cs on its own.
  -->

</Project>
